generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("record_status")
}

enum AccountStatus {
  ACTIVE                   @map("active")
  INACTIVE                 @map("inactive")
  PASSWORD_CHANGE_REQUIRED @map("password_change_required")

  @@map("account_status")
}

enum SessionStatus {
  ACTIVE  @map("active")
  CLOSED  @map("closed")
  REVOKED @map("revoked")

  @@map("session_status")
}

enum CustomerStatus {
  ACTIVE @map("active")
  MERGED @map("merged")

  @@map("customer_status")
}

enum SaleLifecycleStatus {
  DRAFT     @map("draft")
  CONFIRMED @map("confirmed")
  FINALIZED @map("finalized")
  CANCELLED @map("cancelled")

  @@map("sale_lifecycle_status")
}

enum PaymentMethod {
  CASH @map("cash")
  YAPE @map("yape")
  PLIN @map("plin")
  POS  @map("pos")

  @@map("payment_method")
}

enum PaymentStatus {
  CONFIRMED           @map("confirmed")
  PARTIALLY_CORRECTED @map("partially_corrected")
  CORRECTED           @map("corrected")

  @@map("payment_status")
}

enum CashMovementDirection {
  INFLOW  @map("inflow")
  OUTFLOW @map("outflow")

  @@map("cash_movement_direction")
}

enum CashMovementStatus {
  CONFIRMED   @map("confirmed")
  COMPENSATED @map("compensated")

  @@map("cash_movement_status")
}

enum SaleClosureType {
  COMPLETE   @map("complete")
  INCOMPLETE @map("incomplete")

  @@map("sale_closure_type")
}

enum ReturnCondition {
  AVAILABLE @map("available")
  REVIEW    @map("review")

  @@map("return_condition")
}

enum InventoryReservationStatus {
  ACTIVE             @map("active")
  PARTIALLY_CONSUMED @map("partially_consumed")
  CONSUMED           @map("consumed")
  RELEASED           @map("released")

  @@map("inventory_reservation_status")
}

enum LocationType {
  STORE     @map("store")
  WAREHOUSE @map("warehouse")

  @@map("location_type")
}

enum InventoryMovementType {
  OPENING          @map("opening")
  PURCHASE_IN      @map("purchase_in")
  RESERVATION      @map("reservation")
  RELEASE          @map("release")
  DELIVERY         @map("delivery")
  RETURN_REVIEW    @map("return_review")
  RETURN_AVAILABLE @map("return_available")
  TRANSFER_OUT     @map("transfer_out")
  TRANSFER_IN      @map("transfer_in")
  WRITE_OFF        @map("write_off")
  ADJUSTMENT_IN    @map("adjustment_in")
  ADJUSTMENT_OUT   @map("adjustment_out")

  @@map("inventory_movement_type")
}

enum InventoryAdministrativeCategory {
  DAMAGED   @map("damaged")
  LOST      @map("lost")
  DEFECTIVE @map("defective")
  OTHER     @map("other")

  @@map("inventory_administrative_category")
}

enum CostingPolicy {
  MOVING_AVERAGE_V1 @map("moving_average_v1")

  @@map("costing_policy")
}

enum CostMovementType {
  OPENING          @map("opening")
  PURCHASE_IN      @map("purchase_in")
  SALE_ALLOCATION  @map("sale_allocation")
  RESERVATION      @map("reservation")
  RELEASE          @map("release")
  RETURN_REVIEW    @map("return_review")
  RETURN_AVAILABLE @map("return_available")
  WRITE_OFF        @map("write_off")
  ADJUSTMENT_IN    @map("adjustment_in")
  ADJUSTMENT_OUT   @map("adjustment_out")

  @@map("cost_movement_type")
}

enum SupplierKind {
  REGISTERED @map("registered")
  OCCASIONAL @map("occasional")

  @@map("supplier_kind")
}

enum SupplierAdvanceStatus {
  PENDING  @map("pending")
  RESOLVED @map("resolved")

  @@map("supplier_advance_status")
}

enum PurchaseStatus {
  CONFIRMED @map("confirmed")

  @@map("purchase_status")
}

model AccessProfile {
  id             String              @id @db.Uuid
  name           String
  nameNormalized String              @unique(map: "uq_access_profiles_name_normalized") @map("name_normalized")
  status         RecordStatus        @default(ACTIVE)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  permissions    ProfilePermission[]
  accounts       UserAccount[]

  @@map("access_profiles")
}

model Permission {
  id        String              @id @db.Uuid
  code      String              @unique(map: "uq_permissions_code")
  module    String
  action    String
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  profiles  ProfilePermission[]

  @@index([module, action], map: "idx_permissions_module_action")
  @@map("permissions")
}

model ProfilePermission {
  profileId    String        @map("profile_id") @db.Uuid
  permissionId String        @map("permission_id") @db.Uuid
  profile      AccessProfile @relation(fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permission   Permission    @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([profileId, permissionId], map: "pk_profile_permissions")
  @@index([permissionId], map: "idx_profile_permissions_permission")
  @@map("profile_permissions")
}

model UserAccount {
  id                   String                   @id @db.Uuid
  profileId            String                   @map("profile_id") @db.Uuid
  usernameNormalized   String                   @unique(map: "uq_user_accounts_username_normalized") @map("username_normalized")
  credentialHash       String                   @map("credential_hash")
  status               AccountStatus            @default(PASSWORD_CHANGE_REQUIRED)
  securityVersion      Int                      @default(1) @map("security_version")
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile              AccessProfile            @relation(fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessions             Session[]
  inventoryTransfers   InventoryTransfer[]
  inventoryMovements   InventoryMovement[]
  costMovements        CostMovement[]
  customerMerges       CustomerMerge[]
  createdSales         Sale[]
  approvedSaleLines    SaleLine[]               @relation("SaleLinePriceApprover")
  confirmedSales       Sale[]                   @relation("SaleConfirmer")
  registeredPayments   Payment[]
  paymentCorrections   PaymentCorrection[]
  cashMovements        CashMovement[]
  saleTotalAdjustments SaleTotalAdjustment[]
  saleClosures         SaleClosure[]
  approvedReturns      SaleReturn[]
  registeredRefunds    ReturnRefund[]
  saleCancellations    SaleCancellation[]
  cancellationRefunds  SaleCancellationRefund[]
  deliveries           Delivery[]
  registeredAdvances   SupplierAdvance[]
  advanceRefunds       AdvanceRefund[]
  advanceLosses        AdvanceLoss[]
  createdPurchases     Purchase[]               @relation("PurchaseCreator")
  confirmedPurchases   Purchase[]               @relation("PurchaseConfirmer")
  advanceApplications  AdvanceApplication[]

  @@index([profileId, status], map: "idx_user_accounts_profile_status")
  @@map("user_accounts")
}

model Session {
  id                    String        @id @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  protectedCredential   String        @unique(map: "uq_sessions_protected_credential") @map("protected_credential")
  issuedSecurityVersion Int           @map("issued_security_version")
  status                SessionStatus @default(ACTIVE)
  metadata              Json?
  issuedAt              DateTime      @map("issued_at") @db.Timestamptz(3)
  renewedAt             DateTime      @map("renewed_at") @db.Timestamptz(3)
  credentialExpiresAt   DateTime      @map("credential_expires_at") @db.Timestamptz(3)
  endedAt               DateTime?     @map("ended_at") @db.Timestamptz(3)
  endReason             String?       @map("end_reason")
  user                  UserAccount   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, status], map: "idx_sessions_user_status")
  @@map("sessions")
}

model Customer {
  id                   String          @id @db.Uuid
  name                 String
  nameNormalized       String          @map("name_normalized")
  phoneNormalized      String          @map("phone_normalized")
  dni                  String?
  address              String?
  status               CustomerStatus  @default(ACTIVE)
  mergedIntoCustomerId String?         @map("merged_into_customer_id") @db.Uuid
  version              Int             @default(1)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  mergedInto           Customer?       @relation("CustomerMerges", fields: [mergedIntoCustomerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customers_merged_into")
  mergedCustomers      Customer[]      @relation("CustomerMerges")
  mergesAsPrimary      CustomerMerge[] @relation("CustomerMergePrimary")
  mergeAsDuplicate     CustomerMerge?  @relation("CustomerMergeDuplicate")
  sales                Sale[]

  @@index([nameNormalized, id], map: "idx_customers_search_name")
  @@index([mergedIntoCustomerId], map: "idx_customers_merged_into")
  @@map("customers")
}

model CustomerMerge {
  id                       String      @id @db.Uuid
  operationId              String      @unique(map: "uq_customer_merges_operation") @map("operation_id") @db.Uuid
  primaryCustomerId        String      @map("primary_customer_id") @db.Uuid
  duplicateCustomerId      String      @unique(map: "uq_customer_merges_duplicate") @map("duplicate_customer_id") @db.Uuid
  expectedPrimaryVersion   Int         @map("expected_primary_version")
  expectedDuplicateVersion Int         @map("expected_duplicate_version")
  resolvedName             String      @map("resolved_name")
  resolvedPhoneNormalized  String      @map("resolved_phone_normalized")
  resolvedDni              String?     @map("resolved_dni")
  resolvedAddress          String?     @map("resolved_address")
  mergedBy                 String      @map("merged_by") @db.Uuid
  mergedAt                 DateTime    @map("merged_at") @db.Timestamptz(3)
  primaryCustomer          Customer    @relation("CustomerMergePrimary", fields: [primaryCustomerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_merges_primary")
  duplicateCustomer        Customer    @relation("CustomerMergeDuplicate", fields: [duplicateCustomerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_merges_duplicate")
  actor                    UserAccount @relation(fields: [mergedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customer_merges_actor")

  @@index([primaryCustomerId, mergedAt(sort: Desc), id(sort: Desc)], map: "idx_customer_merges_primary_date")
  @@map("customer_merges")
}

model Supplier {
  id             String            @id @db.Uuid
  name           String
  nameNormalized String            @map("name_normalized")
  kind           SupplierKind      @default(REGISTERED)
  phone          String?
  document       String?
  description    String?
  status         RecordStatus      @default(ACTIVE)
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  advances       SupplierAdvance[]
  purchases      Purchase[]

  @@index([status, nameNormalized, id], map: "idx_suppliers_status_name")
  @@map("suppliers")
}

model SupplierAdvance {
  id                  String                @id @db.Uuid
  operationId         String                @unique(map: "uq_supplier_advances_operation") @map("operation_id") @db.Uuid
  requestFingerprint  String                @map("request_fingerprint")
  supplierId          String                @map("supplier_id") @db.Uuid
  originalAmountCents BigInt                @map("original_amount_cents")
  currentBalanceCents BigInt                @map("current_balance_cents")
  method              PaymentMethod
  purpose             String?
  status              SupplierAdvanceStatus @default(PENDING)
  version             Int                   @default(1)
  registeredBy        String                @map("registered_by") @db.Uuid
  effectiveAt         DateTime              @map("effective_at") @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  supplier            Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_supplier_advances_supplier")
  registrar           UserAccount           @relation(fields: [registeredBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_supplier_advances_registrar")
  cashMovement        CashMovement?
  refunds             AdvanceRefund[]
  losses              AdvanceLoss[]
  applications        AdvanceApplication[]

  @@index([supplierId, status, effectiveAt(sort: Desc), id(sort: Desc)], map: "idx_supplier_advances_supplier_status_date")
  @@index([registeredBy, effectiveAt(sort: Desc), id(sort: Desc)], map: "idx_supplier_advances_registrar_date")
  @@map("supplier_advances")
}

model AdvanceRefund {
  id                      String          @id @db.Uuid
  operationId             String          @unique(map: "uq_advance_refunds_operation") @map("operation_id") @db.Uuid
  requestFingerprint      String          @map("request_fingerprint")
  advanceId               String          @map("advance_id") @db.Uuid
  amountCents             BigInt          @map("amount_cents")
  method                  PaymentMethod
  resultingBalanceCents   BigInt          @map("resulting_balance_cents")
  resultingAdvanceVersion Int             @map("resulting_advance_version")
  registeredBy            String          @map("registered_by") @db.Uuid
  effectiveAt             DateTime        @map("effective_at") @db.Timestamptz(3)
  advance                 SupplierAdvance @relation(fields: [advanceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_advance_refunds_advance")
  registrar               UserAccount     @relation(fields: [registeredBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_advance_refunds_registrar")
  cashMovement            CashMovement?

  @@index([advanceId, effectiveAt, id], map: "idx_advance_refunds_advance_date")
  @@map("advance_refunds")
}

model AdvanceLoss {
  id                      String          @id @db.Uuid
  operationId             String          @unique(map: "uq_advance_losses_operation") @map("operation_id") @db.Uuid
  requestFingerprint      String          @map("request_fingerprint")
  advanceId               String          @map("advance_id") @db.Uuid
  amountCents             BigInt          @map("amount_cents")
  reason                  String
  resultingBalanceCents   BigInt          @map("resulting_balance_cents")
  resultingAdvanceVersion Int             @map("resulting_advance_version")
  registeredBy            String          @map("registered_by") @db.Uuid
  effectiveAt             DateTime        @map("effective_at") @db.Timestamptz(3)
  advance                 SupplierAdvance @relation(fields: [advanceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_advance_losses_advance")
  registrar               UserAccount     @relation(fields: [registeredBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_advance_losses_registrar")

  @@index([advanceId, effectiveAt, id], map: "idx_advance_losses_advance_date")
  @@map("advance_losses")
}

model Purchase {
  id                  String               @id @db.Uuid
  operationId         String               @unique(map: "uq_purchases_operation") @map("operation_id") @db.Uuid
  requestFingerprint  String               @map("request_fingerprint")
  supplierId          String               @map("supplier_id") @db.Uuid
  status              PurchaseStatus       @default(CONFIRMED)
  totalCents          BigInt               @map("total_cents")
  advanceAppliedCents BigInt               @map("advance_applied_cents")
  newlyPaidCents      BigInt               @map("newly_paid_cents")
  paymentMethod       PaymentMethod?       @map("payment_method")
  createdBy           String               @map("created_by") @db.Uuid
  confirmedBy         String               @map("confirmed_by") @db.Uuid
  effectiveAt         DateTime             @map("effective_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  supplier            Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_purchases_supplier")
  creator             UserAccount          @relation("PurchaseCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_purchases_creator")
  confirmer           UserAccount          @relation("PurchaseConfirmer", fields: [confirmedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_purchases_confirmer")
  lines               PurchaseLine[]
  advanceApplications AdvanceApplication[]
  cashMovement        CashMovement?

  @@index([supplierId, effectiveAt(sort: Desc), id(sort: Desc)], map: "idx_purchases_supplier_date")
  @@index([confirmedBy, effectiveAt(sort: Desc), id(sort: Desc)], map: "idx_purchases_confirmer_date")
  @@map("purchases")
}

model PurchaseLine {
  id                            String              @id @db.Uuid
  purchaseId                    String              @map("purchase_id") @db.Uuid
  productId                     String              @map("product_id") @db.Uuid
  destinationLocationId         String              @map("destination_location_id") @db.Uuid
  quantity                      Int
  unitCostCents                 BigInt              @map("unit_cost_cents")
  subtotalCents                 BigInt              @map("subtotal_cents")
  previousAverageUnitCostCents  BigInt?             @map("previous_average_unit_cost_cents")
  resultingAverageUnitCostCents BigInt              @map("resulting_average_unit_cost_cents")
  priceReviewSuggested          Boolean             @map("price_review_suggested")
  purchase                      Purchase            @relation(fields: [purchaseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_purchase_lines_purchase")
  product                       Product             @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_purchase_lines_product")
  destinationLocation           Location            @relation(fields: [destinationLocationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_purchase_lines_location")
  inventoryMovements            InventoryMovement[]

  @@unique([purchaseId, productId, destinationLocationId], map: "uq_purchase_lines_purchase_product_location")
  @@index([productId, purchaseId], map: "idx_purchase_lines_product_purchase")
  @@index([destinationLocationId, purchaseId], map: "idx_purchase_lines_location_purchase")
  @@map("purchase_lines")
}

model AdvanceApplication {
  id                      String          @id @db.Uuid
  advanceId               String          @map("advance_id") @db.Uuid
  purchaseId              String          @map("purchase_id") @db.Uuid
  amountCents             BigInt          @map("amount_cents")
  expectedAdvanceVersion  Int             @map("expected_advance_version")
  resultingBalanceCents   BigInt          @map("resulting_balance_cents")
  resultingAdvanceVersion Int             @map("resulting_advance_version")
  appliedBy               String          @map("applied_by") @db.Uuid
  effectiveAt             DateTime        @map("effective_at") @db.Timestamptz(3)
  advance                 SupplierAdvance @relation(fields: [advanceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_advance_applications_advance")
  purchase                Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_advance_applications_purchase")
  actor                   UserAccount     @relation(fields: [appliedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_advance_applications_actor")

  @@unique([advanceId, purchaseId], map: "uq_advance_applications_advance_purchase")
  @@index([purchaseId, advanceId], map: "idx_advance_applications_purchase_advance")
  @@map("advance_applications")
}

model Category {
  id             String       @id @db.Uuid
  name           String
  nameNormalized String       @unique(map: "uq_categories_name_normalized") @map("name_normalized")
  description    String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  products       Product[]

  @@index([status, nameNormalized], map: "idx_categories_status_name")
  @@map("categories")
}

model Tag {
  id             String       @id @db.Uuid
  name           String
  nameNormalized String       @unique(map: "uq_tags_name_normalized") @map("name_normalized")
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  products       ProductTag[]

  @@index([status, nameNormalized], map: "idx_tags_status_name")
  @@map("tags")
}

model Product {
  id                  String               @id @db.Uuid
  categoryId          String               @map("category_id") @db.Uuid
  code                String
  codeNormalized      String               @unique(map: "uq_products_code_normalized") @map("code_normalized")
  name                String
  searchName          String               @map("search_name")
  description         String?
  minimumPriceCents   BigInt               @map("minimum_price_cents")
  suggestedPriceCents BigInt?              @map("suggested_price_cents")
  maximumPriceCents   BigInt?              @map("maximum_price_cents")
  status              RecordStatus         @default(ACTIVE)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  category            Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_products_category")
  tags                ProductTag[]
  images              ProductImage[]
  inventoryPositions  InventoryPosition[]
  inventoryTransfers  InventoryTransfer[]
  inventoryMovements  InventoryMovement[]
  costPosition        ProductCostPosition?
  costMovements       CostMovement[]
  saleLines           SaleLine[]
  purchaseLines       PurchaseLine[]

  @@index([categoryId, status], map: "idx_products_category_status")
  @@index([searchName, id], map: "idx_products_search_name_id")
  @@map("products")
}

model ProductTag {
  productId String  @map("product_id") @db.Uuid
  tagId     String  @map("tag_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_product_tags_product")
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_product_tags_tag")

  @@id([productId, tagId], map: "pk_product_tags")
  @@index([tagId, productId], map: "idx_product_tags_tag_product")
  @@map("product_tags")
}

model ProductImage {
  id         String  @id @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  storageKey String  @unique(map: "uq_product_images_storage_key") @map("storage_key")
  position   Int
  metadata   Json?
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_product_images_product")

  @@unique([productId, position], map: "uq_product_images_product_position")
  @@map("product_images")
}

model Location {
  id                    String                 @id @db.Uuid
  code                  String                 @unique(map: "uq_locations_code")
  name                  String
  type                  LocationType
  status                RecordStatus           @default(ACTIVE)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  inventoryPositions    InventoryPosition[]
  inventoryMovements    InventoryMovement[]
  outgoingTransfers     InventoryTransfer[]    @relation("TransferOrigin")
  incomingTransfers     InventoryTransfer[]    @relation("TransferDestination")
  saleLines             SaleLine[]
  inventoryReservations InventoryReservation[]
  returnLines           ReturnLine[]
  cancellationLines     SaleCancellationLine[]
  deliveryLines         DeliveryLine[]
  purchaseLines         PurchaseLine[]

  @@index([status, name], map: "idx_locations_status_name")
  @@map("locations")
}

model Sale {
  id                      String                @id @db.Uuid
  createdBy               String                @map("created_by") @db.Uuid
  customerId              String?               @map("customer_id") @db.Uuid
  lifecycleStatus         SaleLifecycleStatus   @default(DRAFT) @map("lifecycle_status")
  originalTotalCents      BigInt                @default(0) @map("original_total_cents")
  currentTotalCents       BigInt                @default(0) @map("current_total_cents")
  dueDate                 DateTime?             @map("due_date") @db.Date
  paymentAgreementNote    String?               @map("payment_agreement_note")
  version                 Int                   @default(1)
  confirmedAt             DateTime?             @map("confirmed_at") @db.Timestamptz(3)
  confirmationOperationId String?               @unique(map: "uq_sales_confirmation_operation") @map("confirmation_operation_id") @db.Uuid
  confirmationFingerprint String?               @map("confirmation_fingerprint")
  confirmedBy             String?               @map("confirmed_by") @db.Uuid
  finalizedAt             DateTime?             @map("finalized_at") @db.Timestamptz(3)
  cancelledAt             DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  creator                 UserAccount           @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_creator")
  customer                Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_customer")
  confirmer               UserAccount?          @relation("SaleConfirmer", fields: [confirmedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sales_confirmer")
  lines                   SaleLine[]
  payments                Payment[]
  totalAdjustments        SaleTotalAdjustment[]
  closure                 SaleClosure?
  returns                 SaleReturn[]
  cancellation            SaleCancellation?
  deliveries              Delivery[]

  @@index([createdBy, lifecycleStatus, updatedAt(sort: Desc), id(sort: Desc)], map: "idx_sales_creator_status_date")
  @@index([customerId, confirmedAt(sort: Desc), id(sort: Desc)], map: "idx_sales_customer_date")
  @@index([lifecycleStatus, dueDate, id], map: "idx_sales_status_due_date")
  @@map("sales")
}

