generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("record_status")
}

model Category {
  id             String       @id @db.Uuid
  name           String
  nameNormalized String       @unique(map: "uq_categories_name_normalized") @map("name_normalized")
  description    String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, nameNormalized], map: "idx_categories_status_name")
  @@map("categories")
}
