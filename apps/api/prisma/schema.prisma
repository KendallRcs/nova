generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("record_status")
}

enum AccountStatus {
  ACTIVE                   @map("active")
  INACTIVE                 @map("inactive")
  PASSWORD_CHANGE_REQUIRED @map("password_change_required")

  @@map("account_status")
}

enum SessionStatus {
  ACTIVE  @map("active")
  CLOSED  @map("closed")
  REVOKED @map("revoked")

  @@map("session_status")
}

enum CustomerStatus {
  ACTIVE @map("active")
  MERGED @map("merged")

  @@map("customer_status")
}

enum LocationType {
  STORE     @map("store")
  WAREHOUSE @map("warehouse")

  @@map("location_type")
}

enum InventoryMovementType {
  OPENING          @map("opening")
  PURCHASE_IN      @map("purchase_in")
  RESERVATION      @map("reservation")
  RELEASE          @map("release")
  DELIVERY         @map("delivery")
  RETURN_REVIEW    @map("return_review")
  RETURN_AVAILABLE @map("return_available")
  TRANSFER_OUT     @map("transfer_out")
  TRANSFER_IN      @map("transfer_in")
  WRITE_OFF        @map("write_off")
  ADJUSTMENT_IN    @map("adjustment_in")
  ADJUSTMENT_OUT   @map("adjustment_out")

  @@map("inventory_movement_type")
}

enum InventoryAdministrativeCategory {
  DAMAGED   @map("damaged")
  LOST      @map("lost")
  DEFECTIVE @map("defective")
  OTHER     @map("other")

  @@map("inventory_administrative_category")
}

enum CostingPolicy {
  MOVING_AVERAGE_V1 @map("moving_average_v1")

  @@map("costing_policy")
}

enum CostMovementType {
  OPENING          @map("opening")
  PURCHASE_IN      @map("purchase_in")
  SALE_ALLOCATION  @map("sale_allocation")
  RESERVATION      @map("reservation")
  RELEASE          @map("release")
  RETURN_REVIEW    @map("return_review")
  RETURN_AVAILABLE @map("return_available")
  WRITE_OFF        @map("write_off")
  ADJUSTMENT_IN    @map("adjustment_in")
  ADJUSTMENT_OUT   @map("adjustment_out")

  @@map("cost_movement_type")
}

model AccessProfile {
  id             String              @id @db.Uuid
  name           String
  nameNormalized String              @unique(map: "uq_access_profiles_name_normalized") @map("name_normalized")
  status         RecordStatus        @default(ACTIVE)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  permissions    ProfilePermission[]
  accounts       UserAccount[]

  @@map("access_profiles")
}

model Permission {
  id        String              @id @db.Uuid
  code      String              @unique(map: "uq_permissions_code")
  module    String
  action    String
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  profiles  ProfilePermission[]

  @@index([module, action], map: "idx_permissions_module_action")
  @@map("permissions")
}

model ProfilePermission {
  profileId    String        @map("profile_id") @db.Uuid
  permissionId String        @map("permission_id") @db.Uuid
  profile      AccessProfile @relation(fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permission   Permission    @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([profileId, permissionId], map: "pk_profile_permissions")
  @@index([permissionId], map: "idx_profile_permissions_permission")
  @@map("profile_permissions")
}

model UserAccount {
  id                 String              @id @db.Uuid
  profileId          String              @map("profile_id") @db.Uuid
  usernameNormalized String              @unique(map: "uq_user_accounts_username_normalized") @map("username_normalized")
  credentialHash     String              @map("credential_hash")
  status             AccountStatus       @default(PASSWORD_CHANGE_REQUIRED)
  securityVersion    Int                 @default(1) @map("security_version")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile            AccessProfile       @relation(fields: [profileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessions           Session[]
  inventoryTransfers InventoryTransfer[]
  inventoryMovements InventoryMovement[]
  costMovements      CostMovement[]

  @@index([profileId, status], map: "idx_user_accounts_profile_status")
  @@map("user_accounts")
}

model Session {
  id                    String        @id @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  protectedCredential   String        @unique(map: "uq_sessions_protected_credential") @map("protected_credential")
  issuedSecurityVersion Int           @map("issued_security_version")
  status                SessionStatus @default(ACTIVE)
  metadata              Json?
  issuedAt              DateTime      @map("issued_at") @db.Timestamptz(3)
  renewedAt             DateTime      @map("renewed_at") @db.Timestamptz(3)
  credentialExpiresAt   DateTime      @map("credential_expires_at") @db.Timestamptz(3)
  endedAt               DateTime?     @map("ended_at") @db.Timestamptz(3)
  endReason             String?       @map("end_reason")
  user                  UserAccount   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, status], map: "idx_sessions_user_status")
  @@map("sessions")
}

model Customer {
  id                   String         @id @db.Uuid
  name                 String
  nameNormalized       String         @map("name_normalized")
  phoneNormalized      String         @map("phone_normalized")
  dni                  String?
  address              String?
  status               CustomerStatus @default(ACTIVE)
  mergedIntoCustomerId String?        @map("merged_into_customer_id") @db.Uuid
  version              Int            @default(1)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  mergedInto           Customer?      @relation("CustomerMerges", fields: [mergedIntoCustomerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customers_merged_into")
  mergedCustomers      Customer[]     @relation("CustomerMerges")

  @@index([nameNormalized, id], map: "idx_customers_search_name")
  @@index([mergedIntoCustomerId], map: "idx_customers_merged_into")
  @@map("customers")
}

model Category {
  id             String       @id @db.Uuid
  name           String
  nameNormalized String       @unique(map: "uq_categories_name_normalized") @map("name_normalized")
  description    String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  products       Product[]

  @@index([status, nameNormalized], map: "idx_categories_status_name")
  @@map("categories")
}

model Tag {
  id             String       @id @db.Uuid
  name           String
  nameNormalized String       @unique(map: "uq_tags_name_normalized") @map("name_normalized")
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  products       ProductTag[]

  @@index([status, nameNormalized], map: "idx_tags_status_name")
  @@map("tags")
}

model Product {
  id                  String               @id @db.Uuid
  categoryId          String               @map("category_id") @db.Uuid
  code                String
  codeNormalized      String               @unique(map: "uq_products_code_normalized") @map("code_normalized")
  name                String
  searchName          String               @map("search_name")
  description         String?
  minimumPriceCents   BigInt               @map("minimum_price_cents")
  suggestedPriceCents BigInt?              @map("suggested_price_cents")
  maximumPriceCents   BigInt?              @map("maximum_price_cents")
  status              RecordStatus         @default(ACTIVE)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  category            Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_products_category")
  tags                ProductTag[]
  images              ProductImage[]
  inventoryPositions  InventoryPosition[]
  inventoryTransfers  InventoryTransfer[]
  inventoryMovements  InventoryMovement[]
  costPosition        ProductCostPosition?
  costMovements       CostMovement[]

  @@index([categoryId, status], map: "idx_products_category_status")
  @@index([searchName, id], map: "idx_products_search_name_id")
  @@map("products")
}

model ProductTag {
  productId String  @map("product_id") @db.Uuid
  tagId     String  @map("tag_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_product_tags_product")
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_product_tags_tag")

  @@id([productId, tagId], map: "pk_product_tags")
  @@index([tagId, productId], map: "idx_product_tags_tag_product")
  @@map("product_tags")
}

model ProductImage {
  id         String  @id @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  storageKey String  @unique(map: "uq_product_images_storage_key") @map("storage_key")
  position   Int
  metadata   Json?
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_product_images_product")

  @@unique([productId, position], map: "uq_product_images_product_position")
  @@map("product_images")
}

model Location {
  id                 String              @id @db.Uuid
  code               String              @unique(map: "uq_locations_code")
  name               String
  type               LocationType
  status             RecordStatus        @default(ACTIVE)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  inventoryPositions InventoryPosition[]
  inventoryMovements InventoryMovement[]
  outgoingTransfers  InventoryTransfer[] @relation("TransferOrigin")
  incomingTransfers  InventoryTransfer[] @relation("TransferDestination")

  @@index([status, name], map: "idx_locations_status_name")
  @@map("locations")
}

model InventoryPosition {
  id               String   @id @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  locationId       String   @map("location_id") @db.Uuid
  physicalQuantity Int      @default(0) @map("physical_quantity")
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  reviewQuantity   Int      @default(0) @map("review_quantity")
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inventory_positions_product")
  location         Location @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inventory_positions_location")

  @@unique([productId, locationId], map: "uq_inventory_positions_product_location")
  @@index([locationId, productId], map: "idx_inventory_positions_location_product")
  @@map("inventory_positions")
}

model InventoryTransfer {
  id                    String              @id @db.Uuid
  operationId           String              @unique(map: "uq_inventory_transfers_operation") @map("operation_id") @db.Uuid
  productId             String              @map("product_id") @db.Uuid
  originLocationId      String              @map("origin_location_id") @db.Uuid
  destinationLocationId String              @map("destination_location_id") @db.Uuid
  quantity              Int
  transferredBy         String              @map("transferred_by") @db.Uuid
  effectiveAt           DateTime            @map("effective_at") @db.Timestamptz(3)
  product               Product             @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inventory_transfers_product")
  originLocation        Location            @relation("TransferOrigin", fields: [originLocationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inventory_transfers_origin")
  destinationLocation   Location            @relation("TransferDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inventory_transfers_destination")
  actor                 UserAccount         @relation(fields: [transferredBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inventory_transfers_actor")
  movements             InventoryMovement[]

  @@index([productId, effectiveAt(sort: Desc), id(sort: Desc)], map: "idx_inventory_transfers_product_date")
  @@map("inventory_transfers")
}

model InventoryMovement {
  id                        String                           @id @db.Uuid
  productId                 String                           @map("product_id") @db.Uuid
  locationId                String                           @map("location_id") @db.Uuid
  type                      InventoryMovementType
  physicalDelta             Int                              @map("physical_delta")
  reservedDelta             Int                              @map("reserved_delta")
  reviewDelta               Int                              @map("review_delta")
  previousPhysicalQuantity  Int                              @map("previous_physical_quantity")
  resultingPhysicalQuantity Int                              @map("resulting_physical_quantity")
  previousReservedQuantity  Int                              @map("previous_reserved_quantity")
  resultingReservedQuantity Int                              @map("resulting_reserved_quantity")
  previousReviewQuantity    Int                              @map("previous_review_quantity")
  resultingReviewQuantity   Int                              @map("resulting_review_quantity")
  actorId                   String                           @map("actor_id") @db.Uuid
  effectiveAt               DateTime                         @map("effective_at") @db.Timestamptz(3)
  reason                    String?
  transferId                String?                          @map("transfer_id") @db.Uuid
  operationId               String?                          @unique(map: "uq_inventory_movements_operation") @map("operation_id") @db.Uuid
  expectedPositionVersion   Int?                             @map("expected_position_version")
  administrativeCategory    InventoryAdministrativeCategory? @map("administrative_category")
  product                   Product                          @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inventory_movements_product")
  location                  Location                         @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inventory_movements_location")
  actor                     UserAccount                      @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inventory_movements_actor")
  transfer                  InventoryTransfer?               @relation(fields: [transferId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inventory_movements_transfer")
  costMovement              CostMovement?

  @@index([productId, locationId, effectiveAt(sort: Desc), id(sort: Desc)], map: "idx_inventory_movements_product_location_date")
  @@index([transferId], map: "idx_inventory_movements_transfer")
  @@map("inventory_movements")
}

model ProductCostPosition {
  id                  String        @id @db.Uuid
  productId           String        @unique(map: "uq_product_cost_positions_product") @map("product_id") @db.Uuid
  availableQuantity   Int           @default(0) @map("available_quantity")
  availableValueCents BigInt        @default(0) @map("available_value_cents")
  reservedQuantity    Int           @default(0) @map("reserved_quantity")
  reservedValueCents  BigInt        @default(0) @map("reserved_value_cents")
  reviewQuantity      Int           @default(0) @map("review_quantity")
  reviewValueCents    BigInt        @default(0) @map("review_value_cents")
  version             Int           @default(1)
  policy              CostingPolicy @default(MOVING_AVERAGE_V1)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  product             Product       @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_product_cost_positions_product")

  @@map("product_cost_positions")
}

model CostMovement {
  id                           String            @id @db.Uuid
  productId                    String            @map("product_id") @db.Uuid
  type                         CostMovementType
  quantityDelta                Int               @map("quantity_delta")
  valueDeltaCents              BigInt            @map("value_delta_cents")
  previousAvailableQuantity    Int               @map("previous_available_quantity")
  resultingAvailableQuantity   Int               @map("resulting_available_quantity")
  previousAvailableValueCents  BigInt            @map("previous_available_value_cents")
  resultingAvailableValueCents BigInt            @map("resulting_available_value_cents")
  previousReservedQuantity     Int               @map("previous_reserved_quantity")
  resultingReservedQuantity    Int               @map("resulting_reserved_quantity")
  previousReservedValueCents   BigInt            @map("previous_reserved_value_cents")
  resultingReservedValueCents  BigInt            @map("resulting_reserved_value_cents")
  previousReviewQuantity       Int               @map("previous_review_quantity")
  resultingReviewQuantity      Int               @map("resulting_review_quantity")
  previousReviewValueCents     BigInt            @map("previous_review_value_cents")
  resultingReviewValueCents    BigInt            @map("resulting_review_value_cents")
  declaredUnitCostCents        BigInt?           @map("declared_unit_cost_cents")
  policy                       CostingPolicy
  actorId                      String            @map("actor_id") @db.Uuid
  effectiveAt                  DateTime          @map("effective_at") @db.Timestamptz(3)
  reason                       String
  inventoryMovementId          String            @unique(map: "uq_cost_movements_inventory_movement") @map("inventory_movement_id") @db.Uuid
  product                      Product           @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_cost_movements_product")
  actor                        UserAccount       @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_cost_movements_actor")
  inventoryMovement            InventoryMovement @relation(fields: [inventoryMovementId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_cost_movements_inventory_movement")

  @@index([productId, effectiveAt(sort: Desc), id(sort: Desc)], map: "idx_cost_movements_product_date")
  @@map("cost_movements")
}
