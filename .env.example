# Desarrollo local. Copia este archivo como .env y cambia los valores si el
# puerto o las credenciales locales chocan con otro servicio.
PORT=3001
NODE_ENV=development
POSTGRES_DB=nova
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nova:nova_local_only@localhost:5432/nova?schema=public
